# Stafforyx HR — Environment Variable Template
# Copy this file to .env and fill in real values for production.
# NEVER commit .env to git.
#
# For local development these variables are OPTIONAL —
# settings.py already has safe development fallbacks.

# Required in production — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-production-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames/IPs.
# A leading-dot entry is a WILDCARD: ".trycloudflare.com" matches every
# Cloudflare quick-tunnel subdomain, so a new tunnel URL never needs a config
# change again. settings.py reads this from the OS environment (this project
# does not auto-load a .env file — set it as a real environment variable).
# Example:
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.61,192.168.1.64,.trycloudflare.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.trycloudflare.com
